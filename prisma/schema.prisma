// Street Food Business System — Phase 0 schema.
//
// Rules that apply to EVERY model added in later phases (spec §3 rule 8, §15.1):
//   * non-null `companyId`, indexed, leading every composite index
//   * every unique constraint composite with companyId
//   * all money and quantity columns are Decimal(14, 4)
//   * reads and writes go through lib/db.ts, never a bare PrismaClient
//
// Phase 1 adds: Area, Location, Cart, Employee, Supplier, Ingredient, Product,
// ProductCategory, PriceList, SetDefinition. Do not add them here early.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  AREA_MANAGER
  SUPERVISOR
  COMMISSARY
  HR
  VENDOR
}

enum BranchType {
  BRANCH
  COMMISSARY
  WAREHOUSE
}

/// The tenant root. One row in the MVP; the column exists on every other table
/// so selling the system to a second operator is a config change, not a rewrite.
model Company {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  currency              String   @default("PHP")
  timezone              String   @default("Asia/Manila")
  businessDayCutoffHour Int      @default(4)
  defaultWastagePct     Decimal  @default(0) @db.Decimal(14, 4)
  cashVarianceThreshold Decimal  @default(100) @db.Decimal(14, 4)
  settings              Json     @default("{}")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  branches  Branch[]
  users     User[]
  auditLogs AuditLog[]
  scopes    UserBranchScope[]

  // Phase 1 master data
  areas               Area[]
  locations           Location[]
  carts               Cart[]
  employees           Employee[]
  employmentEvents    EmploymentEvent[]
  compensationSchemes CompensationScheme[]
  assets              Asset[]
  assetCategories     AssetCategory[]
  assetAssignments    AssetAssignment[]
  suppliers           Supplier[]
  ingredients         Ingredient[]
  supplierIngredients SupplierIngredient[]
  ingredientCosts     IngredientCostHistory[]
  productCategories   ProductCategory[]
  products            Product[]
  priceLists          PriceList[]
  priceListItems      PriceListItem[]
  setDefinitions      SetDefinition[]
  setComponents       SetComponent[]
  positions           Position[]
  recipes             Recipe[]
  recipeLines         RecipeLine[]
  productCostVersions ProductCostVersion[]
  inventoryTxns       InventoryTransaction[]
  stockBalances       StockBalance[]
  stockTransfers      StockTransfer[]
  stockTransferLines  StockTransferLine[]
  productionBatches   ProductionBatch[]
  physicalCounts      PhysicalCount[]
  physicalCountLines  PhysicalCountLine[]
  cartShifts          CartShift[]
  shiftIssues         ShiftIssue[]
  shiftIssueLines     ShiftIssueLine[]
  shiftLines          ShiftLine[]
  targets             Target[]
  compensationRules   CompensationRule[]
  shiftCompensations  ShiftCompensation[]
  deductions          Deduction[]
  payrollRuns         PayrollRun[]
  payrollItems        PayrollItem[]
  shiftSupplies       ShiftSupply[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderLines  PurchaseOrderLine[]
  replenishment       ReplenishmentSuggestion[]
  employeeDocuments   EmployeeDocument[]
  cashCounts          CashCount[]
  shiftAdjustments    ShiftAdjustment[]
}

model Branch {
  id          String     @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        BranchType @default(BRANCH)
  areaId      String?
  address     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopes    UserBranchScope[]
  carts     Cart[]
  employees Employee[]
  shifts    CartShift[]
  area      Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  email        String
  passwordHash String
  name         String
  role         Role
  employeeId   String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopes    UserBranchScope[]
  auditLogs AuditLog[]
  employee  Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // Email is unique per company, not globally: two operators may both have
  // an owner@ address once the system is sold on.
  @@unique([companyId, email])
  @@index([companyId, role])
  @@index([email])
}

model UserBranchScope {
  id        String @id @default(cuid())
  companyId String
  userId    String
  branchId  String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([companyId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  at        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, entityId])
  @@index([companyId, at])
}

// ===========================================================================
// PHASE 1 — MASTER DATA
//
// Every model below carries companyId (spec §3 rule 8). Money and quantities are
// Decimal(14,4) — the unit ladder lives here: Product.piecesPerStick converts the
// stock unit (pieces) to the commercial unit (sticks), and SetComponent expresses
// the incentive unit (sets) in sticks. See spec §5.3.1.
// ===========================================================================

enum LocationType {
  SCHOOL
  OFFICE
  FACTORY
  TERMINAL
  MARKET
  RESIDENTIAL
  COMMERCIAL
  OTHER
}

enum CartType {
  FOOD_CART
  MOTOR_CART
  KIOSK
}

enum CartStatus {
  ACTIVE
  IDLE
  MAINTENANCE
  RETIRED
}

enum EmploymentStatus {
  PROBATIONARY
  REGULAR
  PART_TIME
  CONTRACTUAL
  SEPARATED
}

enum EmploymentEventType {
  HIRED
  REGULARIZED
  TRANSFERRED
  PROMOTED
  RATE_CHANGE
  SUSPENDED
  SEPARATED
}

enum IngredientCategory {
  RAW
  PACKAGING
  CONDIMENT
  OIL
  CONSUMABLE
}

enum BaseUnit {
  G
  ML
  PC
}

/// Pieces are the only stock unit; a stick is the commercial unit (spec §5.3.1).
enum SellingUnit {
  PIECE
  STICK
}

enum PriceScope {
  COMPANY
  BRANCH
  CART
}

/// How a five-product set pays out. PER_COMPONENT is the owner's confirmed choice.
enum SetCompletionMode {
  PER_COMPONENT
  ALL_COMPONENTS
  PROPORTIONAL
}

enum CostSource {
  MANUAL
  PURCHASE_RECEIPT
  IMPORT
}

model Area {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Location {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  type        LocationType @default(OTHER)
  address     String?
  lat         Decimal?     @db.Decimal(10, 7)
  lng         Decimal?     @db.Decimal(10, 7)
  notes       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  carts   Cart[]

  @@unique([companyId, name])
  @@index([companyId, type])
}

model Cart {
  id               String     @id @default(cuid())
  companyId        String
  code             String
  name             String
  type             CartType   @default(FOOD_CART)
  branchId         String
  locationId       String?
  status           CartStatus @default(ACTIVE)
  defaultVendorId  String?
  dailySalesTarget Decimal?   @db.Decimal(14, 4)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdById      String?

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  defaultVendor Employee?   @relation("CartDefaultVendor", fields: [defaultVendorId], references: [id], onDelete: SetNull)
  assignedStaff Employee[]  @relation("EmployeeAssignedCart")
  shifts        CartShift[]

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model CompensationScheme {
  id                   String   @id @default(cuid())
  companyId            String
  name                 String
  baseDailyRate        Decimal  @db.Decimal(14, 4)
  /// Shortages are deducted in full by default; null here means uncapped (spec §15.5).
  deductShortage       Boolean  @default(true)
  maxShortageDeduction Decimal? @db.Decimal(14, 4)
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  rules     CompensationRule[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Employee {
  id                   String           @id @default(cuid())
  companyId            String
  employeeNo           String
  firstName            String
  middleName           String?
  lastName             String
  birthDate            DateTime?        @db.Date
  mobile               String
  email                String?
  address              String?
  emergencyContactName String?
  emergencyContactNo   String?
  position             String
  dateHired            DateTime         @db.Date
  employmentStatus     EmploymentStatus @default(PROBATIONARY)
  separationDate       DateTime?        @db.Date
  branchId             String?
  cartId               String?
  dailyRate            Decimal          @db.Decimal(14, 4)
  compensationSchemeId String?
  supervisorId         String?
  photoKey             String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedCart       Cart?               @relation("EmployeeAssignedCart", fields: [cartId], references: [id], onDelete: SetNull)
  compensationScheme CompensationScheme? @relation(fields: [compensationSchemeId], references: [id], onDelete: SetNull)
  supervisor         Employee?           @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports            Employee[]          @relation("EmployeeSupervisor")
  cartsDefaulted     Cart[]              @relation("CartDefaultVendor")
  events             EmploymentEvent[]
  logins             User[]
  documents          EmployeeDocument[]
  shifts             CartShift[]         @relation("ShiftVendor")

  @@unique([companyId, employeeNo])
  @@index([companyId, isActive])
  @@index([companyId, branchId])
}

model EmploymentEvent {
  id            String              @id @default(cuid())
  companyId     String
  employeeId    String
  type          EmploymentEventType
  effectiveDate DateTime            @db.Date
  details       Json                @default("{}")
  createdAt     DateTime            @default(now())
  createdById   String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, effectiveDate])
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  contactPerson String?
  mobile        String?
  address       String?
  leadTimeDays  Int      @default(1)
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ingredients SupplierIngredient[]
  assets      Asset[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Ingredient {
  id                     String             @id @default(cuid())
  companyId              String
  sku                    String
  name                   String
  category               IngredientCategory @default(RAW)
  baseUnit               BaseUnit           @default(G)
  /// Current cost of ONE base unit. Changing it writes IngredientCostHistory (Phase 2).
  currentCostPerBaseUnit Decimal            @db.Decimal(14, 4)
  minStock               Decimal            @default(0) @db.Decimal(14, 4)
  safetyStock            Decimal            @default(0) @db.Decimal(14, 4)
  packSize               Decimal            @default(1) @db.Decimal(14, 4)
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  createdById            String?

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  suppliers   SupplierIngredient[]
  costHistory IngredientCostHistory[]
  recipeLines RecipeLine[]

  @@unique([companyId, sku])
  @@index([companyId, category, isActive])
}

model SupplierIngredient {
  id                       String   @id @default(cuid())
  companyId                String
  supplierId               String
  ingredientId             String
  /// How the supplier sells it: "sack 25kg", "tray 30pcs".
  purchaseUnitName         String
  baseUnitsPerPurchaseUnit Decimal  @db.Decimal(14, 4)
  lastPurchasePrice        Decimal  @db.Decimal(14, 4)
  isPreferred              Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  createdById              String?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
  @@index([companyId, ingredientId])
}

model IngredientCostHistory {
  id              String     @id @default(cuid())
  companyId       String
  ingredientId    String
  costPerBaseUnit Decimal    @db.Decimal(14, 4)
  effectiveFrom   DateTime
  source          CostSource @default(MANUAL)
  refId           String?
  createdAt       DateTime   @default(now())
  createdById     String?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([companyId, ingredientId, effectiveFrom])
}

model ProductCategory {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, sortOrder])
}

model Product {
  id             String      @id @default(cuid())
  companyId      String
  sku            String
  name           String
  categoryId     String
  sellingUnit    SellingUnit @default(STICK)
  /// Pieces on one stick: kwek-kwek 4, calamares 3, squidball 5, fishball 10, kikiam 4.
  piecesPerStick Decimal     @default(1) @db.Decimal(14, 4)
  imageKey       String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceListItems  PriceListItem[]
  setComponents   SetComponent[]
  recipes         Recipe[]
  costVersions    ProductCostVersion[]
  shiftLines      ShiftLine[]
  shiftIssueLines ShiftIssueLine[]

  @@unique([companyId, sku])
  @@index([companyId, categoryId, isActive])
}

model PriceList {
  id            String     @id @default(cuid())
  companyId     String
  name          String
  scopeType     PriceScope @default(COMPANY)
  scopeId       String?
  effectiveFrom DateTime   @db.Date
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdById   String?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PriceListItem[]

  @@unique([companyId, name])
  @@index([companyId, scopeType, isActive])
}

model PriceListItem {
  id            String   @id @default(cuid())
  companyId     String
  priceListId   String
  productId     String
  /// What a customer pays for one stick. pricePerPiece is derived, never stored.
  pricePerStick Decimal  @db.Decimal(14, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([companyId, productId])
}

model SetDefinition {
  id                  String            @id @default(cuid())
  companyId           String
  code                String
  name                String
  /// Pesos earned for a full set. Split across components under PER_COMPONENT.
  incentiveAmount     Decimal           @db.Decimal(14, 4)
  completionMode      SetCompletionMode @default(PER_COMPONENT)
  /// null = a component may stack credits without limit (spec §8).
  maxSetsPerComponent Int?
  effectiveFrom       DateTime          @db.Date
  isActive            Boolean           @default(true)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdById         String?

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  components SetComponent[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model SetComponent {
  id              String   @id @default(cuid())
  companyId       String
  setDefinitionId String
  productId       String
  /// Sticks of this product needed for one set — 50 in the standard set.
  requiredSticks  Decimal  @db.Decimal(14, 4)
  /// Pesos one credit of THIS component is worth under PER_COMPONENT counting.
  /// null = take an equal share of the set incentive, which is how every set behaved
  /// before the split became editable. Components need not be worth the same: a cart
  /// sells fishball far more easily than calamares.
  creditValue     Decimal? @db.Decimal(14, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  setDefinition SetDefinition @relation(fields: [setDefinitionId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([setDefinitionId, productId])
  @@index([companyId, productId])
}

/// Job titles offered in the employee form. A title typed once is saved here and
/// offered from then on, so the list grows with the business instead of being
/// hardcoded. Employee.position stays free text — renaming a title here must never
/// silently rewrite someone's employment record.
model Position {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

// ===========================================================================
// PHASE 2 — COSTING
//
// allocationBasis is what makes oil, sauce and packaging cost correctly (spec §5.3):
//   PER_BATCH — flour, eggs, seasoning: divided by batchYieldPieces
//   PER_PIECE — cooking oil: attributed to every piece fried
//   PER_STICK — the stick, sauce and cup: charged once per stick sold
// ===========================================================================

enum AllocationBasis {
  PER_BATCH
  PER_PIECE
  PER_STICK
}

enum ComponentType {
  RAW
  PACKAGING
  CONDIMENT
  OIL
  CONSUMABLE
}

enum CostTrigger {
  RECIPE_CREATED
  RECIPE_EDITED
  INGREDIENT_COST_CHANGE
  MANUAL_RECALC
  SEED
}

model Recipe {
  id               String   @id @default(cuid())
  companyId        String
  productId        String
  version          Int      @default(1)
  /// Pieces one batch yields. Divides every PER_BATCH line.
  batchYieldPieces Decimal  @db.Decimal(14, 4)
  isActive         Boolean  @default(true)
  effectiveFrom    DateTime @db.Date
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   RecipeLine[]

  @@unique([productId, version])
  @@index([companyId, productId, isActive])
}

model RecipeLine {
  id              String          @id @default(cuid())
  companyId       String
  recipeId        String
  ingredientId    String
  qtyInBaseUnit   Decimal         @db.Decimal(14, 4)
  /// Trim, spillage and breakage on this line, as a fraction: 0.05 = 5%.
  wastagePct      Decimal         @default(0) @db.Decimal(14, 4)
  allocationBasis AllocationBasis @default(PER_BATCH)
  componentType   ComponentType   @default(RAW)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId, allocationBasis])
  @@index([companyId, ingredientId])
}

/// An immutable cost snapshot. Never edited — a change writes a new row, so last
/// week's reported profit cannot move when an ingredient price changes today
/// (spec §3 rule 4). Shift lines resolve cost by effectiveFrom <= businessDate.
model ProductCostVersion {
  id            String      @id @default(cuid())
  companyId     String
  productId     String
  recipeVersion Int
  effectiveFrom DateTime
  costPerPiece  Decimal     @db.Decimal(14, 4)
  costPerStick  Decimal     @db.Decimal(14, 4)
  /// Where every centavo went: raw, packaging, condiment, oil, consumable, wastage.
  breakdown     Json
  triggeredBy   CostTrigger @default(MANUAL_RECALC)
  note          String?
  createdAt     DateTime    @default(now())
  createdById   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, effectiveFrom])
}

// ===========================================================================
// PHASE 3 — INVENTORY
//
// The ledger is APPEND-ONLY (spec §3 rule 3). Nothing is ever updated or deleted;
// a correction is a new ADJUSTMENT row. StockBalance is a derived cache written in
// the same transaction as the ledger row, and `pnpm rebuild:balances` can rebuild it
// from the ledger alone — a test asserts the two always agree.
// ===========================================================================

enum ItemType {
  INGREDIENT
  PRODUCT
}

// ===========================================================================
// ASSETS — the durable things a cart needs to trade
// ===========================================================================

/**
 * Equipment, not stock. A deep fryer is not consumed by selling, so it never belongs
 * in the inventory ledger — putting it there would make every count and every COGS
 * figure wrong. It is tracked because it is worth money, it lives somewhere specific,
 * and somebody is holding it.
 * Note the LPG distinction the business actually has: the gas is an Ingredient and is
 * consumed; the steel tank is an Asset and comes back.
 */
model Asset {
  id              String             @id @default(cuid())
  companyId       String
  /// Painted or stickered on the thing itself, e.g. AST-0012.
  tag             String
  name            String
  category        String
  serialNo        String?
  acquiredOn      DateTime           @db.Date
  acquisitionCost Decimal            @db.Decimal(14, 4)
  supplierId      String?
  condition       AssetCondition     @default(GOOD)
  status          AssetStatus        @default(IN_USE)
  /// Where it is now. Same shape as a stock location so a cart, branch, warehouse or
  /// a named vendor can all hold one. Null while it is unassigned.
  locationType    StockLocationType?
  locationId      String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdById     String?

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]

  @@unique([companyId, tag])
  @@index([companyId, status])
  @@index([companyId, locationType, locationId])
}

/**
 * Append-only: where an asset has been and who moved it. This is the accountability
 * record — "the fryer was on CART-003 under Carla from 12 Aug" — so rows are written,
 * never edited. Asset.locationType/Id is the cache of the latest row.
 */
model AssetAssignment {
  id               String             @id @default(cuid())
  companyId        String
  assetId          String
  fromLocationType StockLocationType?
  fromLocationId   String?
  toLocationType   StockLocationType?
  toLocationId     String?
  movedOn          DateTime           @db.Date
  reason           String?
  createdAt        DateTime           @default(now())
  createdById      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, assetId, movedOn])
}

/// Categories offered in the asset form. A category typed once is saved here and
/// offered from then on, so the business's own vocabulary accumulates instead of
/// living in an enum that only a deploy can change. Asset.category stays free text —
/// renaming a category here must never silently rewrite an asset's record.
model AssetCategory {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

enum AssetCondition {
  GOOD
  NEEDS_REPAIR
  UNSERVICEABLE
}

enum AssetStatus {
  IN_USE
  IN_STORAGE
  IN_REPAIR
  RETIRED
  LOST
}

enum StockLocationType {
  WAREHOUSE
  BRANCH
  CART
  EMPLOYEE
}

enum InventoryTxnType {
  PURCHASE_RECEIPT
  PRODUCTION_IN
  PRODUCTION_CONSUME
  TRANSFER_OUT
  TRANSFER_IN
  ISSUE_TO_VENDOR
  RETURN_FROM_VENDOR
  SALE_CONSUMPTION
  WASTE
  SPOILAGE
  DAMAGE
  ADJUSTMENT
  COUNT_VARIANCE
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum BatchStatus {
  DRAFT
  COMPLETED
}

enum CountStatus {
  DRAFT
  POSTED
}

model InventoryTransaction {
  id           String            @id @default(cuid())
  companyId    String
  itemType     ItemType
  itemId       String
  locationType StockLocationType
  locationId   String
  /// Signed: positive moves stock in, negative moves it out.
  qty          Decimal           @db.Decimal(14, 4)
  unitCost     Decimal           @db.Decimal(14, 4)
  type         InventoryTxnType
  refType      String
  refId        String
  businessDate DateTime          @db.Date
  occurredAt   DateTime          @default(now())
  reason       String?
  createdAt    DateTime          @default(now())
  createdById  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, itemType, itemId, locationType, locationId])
  @@index([companyId, businessDate])
  @@index([companyId, refType, refId])
}

/// Derived cache. Never the source of truth — rebuild:balances reconstructs it.
model StockBalance {
  id           String            @id @default(cuid())
  companyId    String
  itemType     ItemType
  itemId       String
  locationType StockLocationType
  locationId   String
  qty          Decimal           @default(0) @db.Decimal(14, 4)
  /// Weighted average of what is actually on hand here.
  avgUnitCost  Decimal           @default(0) @db.Decimal(14, 4)
  updatedAt    DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([itemType, itemId, locationType, locationId, companyId])
  @@index([companyId, locationType, locationId])
}

model StockTransfer {
  id               String            @id @default(cuid())
  companyId        String
  reference        String
  fromLocationType StockLocationType
  fromLocationId   String
  toLocationType   StockLocationType
  toLocationId     String
  status           TransferStatus    @default(DRAFT)
  businessDate     DateTime          @db.Date
  dispatchedAt     DateTime?
  dispatchedById   String?
  receivedAt       DateTime?
  receivedById     String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   StockTransferLine[]

  @@unique([companyId, reference])
  @@index([companyId, status])
}

model StockTransferLine {
  id          String   @id @default(cuid())
  companyId   String
  transferId  String
  itemType    ItemType
  itemId      String
  qtySent     Decimal  @db.Decimal(14, 4)
  /// Set on receipt. A gap against qtySent is shrinkage and posts as an ADJUSTMENT.
  qtyReceived Decimal? @db.Decimal(14, 4)
  unitCost    Decimal  @db.Decimal(14, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, itemType, itemId])
  @@index([companyId, itemId])
}

/// The commissary turning ingredients into countable pieces.
model ProductionBatch {
  id            String      @id @default(cuid())
  companyId     String
  reference     String
  branchId      String
  productId     String
  recipeVersion Int
  plannedQty    Decimal     @db.Decimal(14, 4)
  actualQty     Decimal     @default(0) @db.Decimal(14, 4)
  wasteQty      Decimal     @default(0) @db.Decimal(14, 4)
  unitCost      Decimal     @default(0) @db.Decimal(14, 4)
  status        BatchStatus @default(DRAFT)
  businessDate  DateTime    @db.Date
  producedAt    DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, reference])
  @@index([companyId, status, businessDate])
}

model PhysicalCount {
  id           String            @id @default(cuid())
  companyId    String
  reference    String
  locationType StockLocationType
  locationId   String
  status       CountStatus       @default(DRAFT)
  businessDate DateTime          @db.Date
  countedAt    DateTime          @default(now())
  countedById  String?
  postedAt     DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdById  String?

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   PhysicalCountLine[]

  @@unique([companyId, reference])
  @@index([companyId, status])
}

model PhysicalCountLine {
  id         String   @id @default(cuid())
  companyId  String
  countId    String
  itemType   ItemType
  itemId     String
  /// What the ledger said at the moment of counting.
  systemQty  Decimal  @db.Decimal(14, 4)
  countedQty Decimal  @db.Decimal(14, 4)
  variance   Decimal  @db.Decimal(14, 4)
  unitCost   Decimal  @default(0) @db.Decimal(14, 4)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  count   PhysicalCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, itemType, itemId])
  @@index([companyId, itemId])
}

// ===========================================================================
// PHASE 4 — SHIFTS (THE CORE LOOP)
//
// Street-food carts do not ring up transactions. The whole system derives sales,
// COGS, wastage, cash accountability and vendor pay from ONE reconciliation record
// per cart per business date (spec §2).
//
//   issue → refill → count back → qtySold = issued − returned − wasted
// ===========================================================================

enum ShiftStatus {
  OPEN
  CLOSED
  APPROVED
  DISPUTED
}

enum AcknowledgedVia {
  SIGNATURE
  VERBAL_CONFIRMED
  SMS_SENT
  NONE
}

enum TargetScope {
  COMPANY
  BRANCH
  CART
  EMPLOYEE
}

enum TargetPeriod {
  DAY
  WEEK
  MONTH
}

model CartShift {
  id           String      @id @default(cuid())
  companyId    String
  cartId       String
  employeeId   String
  branchId     String
  businessDate DateTime    @db.Date
  status       ShiftStatus @default(OPEN)

  openedAt     DateTime  @default(now())
  openedById   String?
  closedAt     DateTime?
  closedById   String?
  /// Segregation of duties: never equal to closedById (spec §7).
  approvedAt   DateTime?
  approvedById String?

  /// No pay deduction without the vendor acknowledging the count (spec §7).
  vendorAcknowledged Boolean         @default(false)
  acknowledgedAt     DateTime?
  acknowledgedVia    AcknowledgedVia @default(NONE)
  acknowledgedNote   String?
  signatureKey       String?

  cashFloat     Decimal @default(0) @db.Decimal(14, 4)
  cashRemitted  Decimal @default(0) @db.Decimal(14, 4)
  digitalSales  Decimal @default(0) @db.Decimal(14, 4)
  otherPayments Decimal @default(0) @db.Decimal(14, 4)

  grossSales    Decimal @default(0) @db.Decimal(14, 4)
  discountTotal Decimal @default(0) @db.Decimal(14, 4)
  netSales      Decimal @default(0) @db.Decimal(14, 4)
  expectedCash  Decimal @default(0) @db.Decimal(14, 4)
  cashVariance  Decimal @default(0) @db.Decimal(14, 4)
  cogs          Decimal @default(0) @db.Decimal(14, 4)
  wasteCost     Decimal @default(0) @db.Decimal(14, 4)
  grossProfit   Decimal @default(0) @db.Decimal(14, 4)

  notes          String?
  /// Makes closing safe to retry from a phone on bad signal, and offline later.
  idempotencyKey String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: a shift is the financial record of a day's trading, so the
  /// cart, vendor or branch it belongs to cannot be deleted out from under it.
  cart     Cart          @relation(fields: [cartId], references: [id], onDelete: Restrict)
  employee Employee      @relation("ShiftVendor", fields: [employeeId], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issues   ShiftIssue[]
  lines    ShiftLine[]
  supplies ShiftSupply[]

  @@unique([cartId, businessDate])
  @@index([companyId, businessDate, status])
  @@index([companyId, employeeId, businessDate])
}

model ShiftIssue {
  id         String   @id @default(cuid())
  companyId  String
  shiftId    String
  /// 1 = the morning load-out; 2+ = a refill during the day.
  seq        Int
  isRefill   Boolean  @default(false)
  issuedAt   DateTime @default(now())
  issuedById String?
  note       String?
  createdAt  DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift   CartShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  lines   ShiftIssueLine[]

  @@unique([shiftId, seq])
  @@index([companyId, shiftId])
}

model ShiftIssueLine {
  id               String   @id @default(cuid())
  companyId        String
  issueId          String
  productId        String
  /// Pieces. Sticks are commercial, never a stock quantity (spec §5.3.1).
  qtyPieces        Decimal  @db.Decimal(14, 4)
  /// Snapshotted at issue so later price or cost changes cannot rewrite this shift.
  unitCostPerPiece Decimal  @db.Decimal(14, 4)
  pricePerStick    Decimal  @db.Decimal(14, 4)
  piecesPerStick   Decimal  @db.Decimal(14, 4)
  createdAt        DateTime @default(now())

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  issue   ShiftIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([issueId, productId])
  @@index([companyId, productId])
}

/// One row per product per shift, built at closing. ALL QUANTITIES IN PIECES.
model ShiftLine {
  id             String  @id @default(cuid())
  companyId      String
  shiftId        String
  productId      String
  piecesIssued   Decimal @db.Decimal(14, 4)
  piecesReturned Decimal @default(0) @db.Decimal(14, 4)
  piecesWasted   Decimal @default(0) @db.Decimal(14, 4)
  wasteReason    String?
  piecesSold     Decimal @db.Decimal(14, 4)
  sticksSold     Decimal @db.Decimal(14, 4)

  piecesPerStick   Decimal @db.Decimal(14, 4)
  pricePerStick    Decimal @db.Decimal(14, 4)
  unitCostPerPiece Decimal @db.Decimal(14, 4)

  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  grossSales     Decimal @db.Decimal(14, 4)
  netSales       Decimal @db.Decimal(14, 4)
  lineCogs       Decimal @db.Decimal(14, 4)
  lineWasteCost  Decimal @default(0) @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift   CartShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([shiftId, productId])
  @@index([companyId, productId])
}

model Target {
  id          String       @id @default(cuid())
  companyId   String
  scopeType   TargetScope
  scopeId     String?
  metric      String       @default("NET_SALES")
  periodType  TargetPeriod @default(DAY)
  periodStart DateTime     @db.Date
  value       Decimal      @db.Decimal(14, 4)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scopeType, scopeId, metric, periodType, periodStart])
  @@index([companyId, periodStart])
}

// ===========================================================================
// PHASE 5 — COMPENSATION AND PAYROLL
//
// Rules are DATA, not code (spec §5.6). Management edits them in Settings; adding a
// new rule TYPE is the only thing that needs a deploy. Approved payroll snapshots its
// full breakdown, so editing a rule next month cannot rewrite what was already paid.
// ===========================================================================

enum CompensationRuleType {
  SET_COMPLETION
  REFILL_BONUS
  COMMISSION_PCT
  PER_UNIT
  TARGET_BONUS
  ATTENDANCE
}

enum PayStatus {
  DRAFT
  APPROVED
  PAID
}

enum DeductionType {
  CASH_SHORTAGE
  CASH_ADVANCE
  UNRETURNED_ITEM
  DAMAGE
  OTHER
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  APPROVED
  PAID
}

model CompensationRule {
  id              String               @id @default(cuid())
  companyId       String
  schemeId        String
  type            CompensationRuleType
  /// Lower runs first. Only matters when one rule depends on another's result.
  priority        Int                  @default(10)
  /// Shape depends on `type` — see the table in spec §5.6.
  params          Json                 @default("{}")
  scopeProductId  String?
  scopeCategoryId String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdById     String?

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scheme  CompensationScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([companyId, schemeId, isActive])
}

/// What one shift earned the vendor, with the arithmetic kept alongside the figure.
model ShiftCompensation {
  id             String    @id @default(cuid())
  companyId      String
  shiftId        String    @unique
  employeeId     String
  schemeId       String?
  businessDate   DateTime  @db.Date
  basePay        Decimal   @db.Decimal(14, 4)
  incentiveTotal Decimal   @db.Decimal(14, 4)
  deductionTotal Decimal   @db.Decimal(14, 4)
  netPay         Decimal   @db.Decimal(14, 4)
  /// Every line: rule type, label, the computation in words, and the amount.
  breakdown      Json
  status         PayStatus @default(DRAFT)
  payrollItemId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, businessDate])
  @@index([companyId, status])
}

model Deduction {
  id            String        @id @default(cuid())
  companyId     String
  employeeId    String
  shiftId       String?
  payrollItemId String?
  type          DeductionType
  amount        Decimal       @db.Decimal(14, 4)
  note          String?
  /// A deduction the vendor never acknowledged is how these systems get abandoned.
  acknowledged  Boolean       @default(false)
  approvedById  String?
  businessDate  DateTime      @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, businessDate])
}

model PayrollRun {
  id           String        @id @default(cuid())
  companyId    String
  reference    String
  periodStart  DateTime      @db.Date
  periodEnd    DateTime      @db.Date
  branchId     String?
  status       PayrollStatus @default(DRAFT)
  totals       Json          @default("{}")
  reviewedAt   DateTime?
  reviewedById String?
  approvedAt   DateTime?
  approvedById String?
  paidAt       DateTime?
  paidById     String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PayrollItem[]

  @@unique([companyId, reference])
  @@index([companyId, status, periodStart])
}

model PayrollItem {
  id             String   @id @default(cuid())
  companyId      String
  payrollRunId   String
  employeeId     String
  daysWorked     Int      @default(0)
  basePayTotal   Decimal  @db.Decimal(14, 4)
  incentiveTotal Decimal  @db.Decimal(14, 4)
  deductionTotal Decimal  @db.Decimal(14, 4)
  netPay         Decimal  @db.Decimal(14, 4)
  /// Snapshotted on approval so later rule edits cannot rewrite history.
  breakdown      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run     PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([companyId, employeeId])
}

/**
 * Non-sellable items sent out with a cart: sauce, cups, bags, sticks, oil, tissue.
 * Tracked so the owner can see everything a cart consumed, sellable or not — a cart
 * burning through twice the cups of its neighbour is worth knowing about. Their cost
 * is NOT added to the shift: it already sits inside each product's per-stick cost
 * (spec §5.3), and charging it again would make every margin fiction.
 */
model ShiftSupply {
  id           String   @id @default(cuid())
  companyId    String
  shiftId      String
  ingredientId String
  qtyIssued    Decimal  @default(0) @db.Decimal(14, 4)
  qtyReturned  Decimal? @db.Decimal(14, 4)
  qtyConsumed  Decimal? @db.Decimal(14, 4)
  unitCost     Decimal  @db.Decimal(14, 4)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift   CartShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, ingredientId])
  @@index([companyId, ingredientId])
}

// ===========================================================================
// PHASE 6 — EXPENSES AND P&L
//
// Everything between gross profit and what the owner actually keeps (spec §10):
//   Net Sales − COGS = Gross Profit
//     − Labour − Wastage − Direct Operating Expenses = Operating Profit
//     − Allocated Overhead (optional) = Net Profit
// ===========================================================================

enum ExpenseKind {
  COGS
  OPEX
  CAPEX
}

enum ExpenseScope {
  COMPANY
  BRANCH
  CART
}

enum PaymentMethod {
  CASH
  GCASH
  BANK
  CREDIT
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model ExpenseCategory {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  kind        ExpenseKind @default(OPEX)
  /// Company-level costs can be spread across branches by share of sales.
  isOverhead  Boolean     @default(false)
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  recurring RecurringExpense[]

  @@unique([companyId, name])
  @@index([companyId, kind, isActive])
}

model Expense {
  id            String        @id @default(cuid())
  companyId     String
  businessDate  DateTime      @db.Date
  categoryId    String
  scopeType     ExpenseScope  @default(BRANCH)
  scopeId       String?
  employeeId    String?
  amount        Decimal       @db.Decimal(14, 4)
  paymentMethod PaymentMethod @default(CASH)
  description   String
  /// Reference to the receipt. File storage arrives with the 201 files in Phase 9.
  attachmentKey String?
  status        ExpenseStatus @default(DRAFT)
  approvedAt    DateTime?
  approvedById  String?
  recurringId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([companyId, businessDate, status])
  @@index([companyId, scopeType, scopeId])
}

model RecurringExpense {
  id          String             @id @default(cuid())
  companyId   String
  categoryId  String
  scopeType   ExpenseScope       @default(BRANCH)
  scopeId     String?
  amount      Decimal            @db.Decimal(14, 4)
  description String
  frequency   RecurringFrequency @default(MONTHLY)
  nextRunDate DateTime           @db.Date
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdById String?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([companyId, isActive, nextRunDate])
}

// ===========================================================================
// PHASE 8 — PROCUREMENT AND REPLENISHMENT
//
// The lifecycle is deliberate (spec §9): SUGGESTED → APPROVED → ORDERED → RECEIVED.
// Suggestions are data-driven but always overridable — management edits the quantity,
// accepts it, or dismisses it with a reason.
// ===========================================================================

enum PoStatus {
  SUGGESTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SuggestionStatus {
  NEW
  ACCEPTED
  DISMISSED
}

model PurchaseOrder {
  poNo                String    @id @default(cuid())
  companyId           String
  reference           String
  supplierId          String
  destinationBranchId String
  status              PoStatus  @default(SUGGESTED)
  orderedAt           DateTime?
  expectedAt          DateTime? @db.Date
  receivedAt          DateTime?
  totalAmount         Decimal   @default(0) @db.Decimal(14, 4)
  notes               String?
  approvedAt          DateTime?
  approvedById        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   PurchaseOrderLine[]

  @@unique([companyId, reference])
  @@index([companyId, status])
}

model PurchaseOrderLine {
  id                       String   @id @default(cuid())
  companyId                String
  poNo                     String
  ingredientId             String
  /// Ordered in the supplier's unit — "sack 25kg" — and converted on receipt.
  qtyPurchaseUnit          Decimal  @db.Decimal(14, 4)
  purchaseUnitName         String
  baseUnitsPerPurchaseUnit Decimal  @db.Decimal(14, 4)
  unitPrice                Decimal  @db.Decimal(14, 4)
  qtyReceivedBase          Decimal  @default(0) @db.Decimal(14, 4)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  po      PurchaseOrder @relation(fields: [poNo], references: [poNo], onDelete: Cascade)

  @@unique([poNo, ingredientId])
  @@index([companyId, ingredientId])
}

model ReplenishmentSuggestion {
  id            String            @id @default(cuid())
  companyId     String
  itemType      ItemType
  itemId        String
  locationType  StockLocationType
  locationId    String
  onHand        Decimal           @db.Decimal(14, 4)
  avgDailyUsage Decimal           @db.Decimal(14, 4)
  daysOfCover   Decimal?          @db.Decimal(14, 4)
  reorderPoint  Decimal           @db.Decimal(14, 4)
  suggestedQty  Decimal           @db.Decimal(14, 4)
  /// Written in plain language so the owner can judge it without reading the formula.
  reason        String
  status        SuggestionStatus  @default(NEW)
  dismissReason String?
  generatedAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, itemType, itemId, locationType, locationId, status])
  @@index([companyId, status, generatedAt])
}

// ===========================================================================
// PHASE 9 — 201 FILES, CASH COUNTS, ADJUSTMENTS
// ===========================================================================

enum DocumentType {
  CONTRACT
  ID
  CLEARANCE
  HEALTH_CERT
  TRAINING
  PERFORMANCE
  DISCIPLINARY
  GOVT_RECORD
  OTHER
}

/**
 * An employee's 201 file (spec §6). Access is restricted to OWNER, ADMIN and HR, and
 * every view is written to the audit log.
 * `fileRef` is where the document actually lives — a cloud link or the physical folder
 * reference. Binary upload needs object storage, which this deployment does not have;
 * the expiry tracking and the central index are the parts that stop a lapsed health
 * certificate going unnoticed, and those work without it.
 */
model EmployeeDocument {
  id           String       @id @default(cuid())
  companyId    String
  employeeId   String
  type         DocumentType
  title        String
  fileRef      String?
  issuedAt     DateTime?    @db.Date
  expiresAt    DateTime?    @db.Date
  notes        String?
  uploadedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, expiresAt])
}

/// Optional denomination count at closing, for branches that want the cash broken down.
model CashCount {
  id           String   @id @default(cuid())
  companyId    String
  shiftId      String
  denomination Int
  count        Int
  createdAt    DateTime @default(now())
  createdById  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([shiftId, denomination])
  @@index([companyId, shiftId])
}

/**
 * A correction to an APPROVED shift. Approved shifts are immutable (spec §7), so a
 * correction is a recorded adjustment with reversing ledger entries — never an edit.
 */
model ShiftAdjustment {
  id          String   @id @default(cuid())
  companyId   String
  shiftId     String
  reason      String
  /// What the shift said before, kept so the change is legible years later.
  before      Json
  after       Json
  createdAt   DateTime @default(now())
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, shiftId])
}
